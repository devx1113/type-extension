{
  "manifest_version": 3,
  "name": "DeepL Korean Typing",
  "version": "1.2.0",
  "description": "Type Korean (Hangul, 2-set layout) on deepl.com without an OS input method.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "DeepL Korean Typing",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-language": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Switch typing language (Korean/English)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.deepl.com/*"
      ],
      "js": [
        "hangul.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
